module(
    name = "arbiter_core",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.51.0")
bazel_dep(name = "housegate", version = "1.0.0")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")

# Housegate is not published in the Bazel Central Registry. Root consumers
# must repeat this override because Bzlmod deliberately does not inherit
# overrides from dependencies.
git_override(
    module_name = "housegate",
    commit = "06936750928be7e487851d56fb6c862a19408c3f",
    remote = "https://github.com/housegate/housegate",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# Root-only patches required by geth. Consumers apply their own equivalent
# overrides; dev_dependency tags are dropped when arbiter-core is non-root.
go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.module_override(
    patch_strip = 1,
    patches = ["@housegate//third_party:com_github_ethereum_go_ethereum_secp256k1.patch"],
    path = "github.com/ethereum/go-ethereum",
)
go_deps_dev.module_override(
    patch_strip = 1,
    patches = ["@housegate//third_party:com_github_consensys_gnark_crypto.patch"],
    path = "github.com/consensys/gnark-crypto",
)
go_deps_dev.gazelle_default_attributes(
    directives = ["gazelle:proto disable"],
)

use_repo(
    go_deps,
    "com_github_clickhouse_clickhouse_go_v2",
    "com_github_ethereum_go_ethereum",
    "com_github_sentioxyz_arbiter_proto",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
)

# Housegate registers this shared extension. A root consumer must also use it
# so the non-root Housegate module's @zig_sdk repository is generated.
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
)
