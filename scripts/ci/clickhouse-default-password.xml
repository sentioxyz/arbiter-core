<!--
  CI only. Gives the default user of the ephemeral ClickHouse containers a
  password, so every ClickHouse-gated test must connect through
  dataplane/chtest with CH_USER / CH_PASSWORD (housegate spec 2026-10-14 §14:
  credentials in every protocol client first). The containers listen on
  127.0.0.1 and live for one job; this is not a secret.
-->
<clickhouse>
  <users>
    <default>
      <password replace="replace">arbiter-core-ci</password>
    </default>
  </users>
</clickhouse>
