load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "dastore",
    srcs = [
        "client.go",
        "fetch.go",
        "lifecycle.go",
        "put.go",
        "putauth.go",
    ],
    importpath = "github.com/sentioxyz/arbiter-core/dataplane/dastore",
    visibility = ["//visibility:public"],
    deps = [
        "//transport",
        "@com_github_sentioxyz_arbiter_proto//gen/pb",
