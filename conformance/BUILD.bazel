load("@rules_go//go:def.bzl", "go_test")

go_test(
    name = "conformance_test",
    srcs = [
        "arbiter_wire_test.go",
        "replay_wire_test.go",
        "snapshot_query_wire_test.go",
        "statement_envelope_golden_test.go",
        "statement_kind_test.go",
    ],
    data = glob(["testdata/**"]),
    deps = [
        "//:arbiter-core",
        "//wire",
        "@com_github_ethereum_go_ethereum//crypto",
        "@com_github_sentioxyz_arbiter_proto//gen/pb",
        "@housegate//pkg/auth",
        "@housegate//pkg/replay",
        "@housegate//pkg/replay/snapshotquery",
        "@org_golang_google_protobuf//encoding/protojson",
        "@org_golang_google_protobuf//proto",
    ],
)

# The verifier role repeats the same v3 envelope verification before any
# historical read, so its tests replay this immutable identity fixture.
filegroup(
    name = "snapshot_query_testdata",
    srcs = glob(["testdata/snapshot_query_*.json"]),
    visibility = ["//verifier:__pkg__"],
)
