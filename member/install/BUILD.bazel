load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "install",
    srcs = [
        "audit.go",
        "foreign.go",
        "installer.go",
        "journal.go",
        "scratch.go",
    ],
    importpath = "github.com/sentioxyz/arbiter-core/member/install",
